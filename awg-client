#!/bin/bash
# awg-client: manage AmneziaWG clients on this server.
set -euo pipefail
DIR=/etc/amnezia/amneziawg
IF=awg0
CONF=$DIR/$IF.conf
CL=$DIR/clients
TXN_ROOT=$DIR/transactions


# Shared helpers (die, kv, take_lock, prune_backups, obfuscation values): the lib/ next to this
# script in a kit checkout, otherwise the copy install.sh/update.sh put on the server.
LIB=$(dirname "$(readlink -f "$0")")/lib/common.sh
[ -r "$LIB" ] || LIB=/usr/local/lib/awg-vps-kit/common.sh
if [ ! -r "$LIB" ]; then echo "error: $LIB is missing; reinstall the kit or run update.sh" >&2; exit 1; fi
# shellcheck source=lib/common.sh
. "$LIB"

usage() {
cat <<'EOF'
awg-client - manage AmneziaWG clients on this server (run as root)

Usage:
  awg-client add <name>      create a client, print its config and QR code
  awg-client show <name>     print an existing client's config and QR code again
  awg-client list [-v]       list all clients with their tunnel addresses
                             (-v: last handshake, traffic and endpoint of each)
  awg-client remove <name>   remove a client (takes effect immediately)
  awg-client rename <old> <new>       give a client another name (devices are not affected)
  awg-client export [file.tar.gz]     all client configs in one archive (contains private keys)
  awg-client version         show installed kit and amneziawg versions
  awg-client protocol [1.0|1.5|2.0|3.1]   show or change the protocol version of this server
  awg-client mtu [1280-1500]          show or set the MTU written into client configs (default 1420; never 1280 by default: sites flag it as a VPN)
  awg-client dns [ADDR[,ADDR]|default]  show or set the DNS servers written into client configs (default 1.1.1.1)
  awg-client endpoint [ADDR]          show or set the server address written into client configs (after the server IP changed)
  awg-client help            this help

Notes:
  - Name: letters, digits, _ and - only (max 32 characters).
  - The next free tunnel address is picked automatically.
  - The tunnel must be running: add and remove refuse to change files when the
    interface is down, so a stored peer and the running one never disagree.
  - Clients are added to the running tunnel without a restart and are
    also written to /etc/amnezia/amneziawg/awg0.conf (survives reboot).
  - Client files: /etc/amnezia/amneziawg/clients/<name>.{conf,key,pub,psk}
  - One config per device: two devices on the same config kick each other off.
  - Removing a client disconnects that device immediately.
  - `protocol 2.0` rewrites the server obfuscation fields and restarts the tunnel: every client
    must then get its new config (`awg-client show <name>`), old configs stop working.
  - Switching only between 1.0 and 1.5 keeps the server fields: no restart, existing clients keep
    working; new configs get the I1-I5 fields for 1.5.
  - `protocol 3.1` (header protection, RandomTrailers) needs a client with Amnezia VPN >= 5.0.1.5;
    such client configs default to MTU 1420 like the others (1280 is a VPN fingerprint), `awg-client mtu` overrides it.
  - `mtu N` only changes the MTU line of client configs (server awg0 is not touched, no restart).
    Devices that are already set up keep their old MTU until they import `awg-client show <name>` again.
  - `dns` works the same way: up to 3 IPv4 addresses (the tunnel is IPv4-only), new and re-shown
    configs get them, devices keep the old ones until they import the config again.
  - `endpoint ADDR` takes an IPv4, IPv6 or DNS name, rewrites the stored client files and prints nothing else to do
    on the server (the tunnel is not touched, no restart); devices keep the old address until they import
    `awg-client show <name>` again. Use it after the hoster changed the server IP.
  - `rename` changes the name in awg0.conf and the file names only; keys, address and the running
    peer stay as they are, so the device keeps working and needs no new config.
  - `export` writes every client config, in the current format, to one .tar.gz (default
    ./awg-clients-<host>-<time>.tar.gz, mode 600, never overwrites). The archive holds private keys.
  - If a peer operation was interrupted, /etc/amnezia/amneziawg/transactions/peer.* stays
    behind and further changes are refused: check awg0.conf, then remove that directory.
  - Details: /etc/amnezia/amneziawg/README.md
EOF
}

valid_endpoint() {  # valid_endpoint <addr>: IPv4, IPv6 literal or DNS name (no brackets, no port)
  local a=$1 o IFS=.
  if [ -z "$a" ] || [ "${#a}" -gt 253 ]; then return 1; fi
  if [[ $a =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    for o in $a; do if [ "${#o}" -gt 3 ] || [ "$((10#$o))" -gt 255 ]; then return 1; fi; done
    return 0
  fi
  if [[ $a == *:* ]]; then [[ $a =~ ^[0-9A-Fa-f:.]+$ && $a == *:*:* ]]; return; fi
  [[ $a =~ ^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}$ ]]
}
format_endpoint() {  # format_endpoint <host> <port>; brackets bare IPv6 literals
  case "$1" in
    \[*\]) printf '%s:%s\n' "$1" "$2" ;;
    *:*)   printf '[%s]:%s\n' "$1" "$2" ;;
    *)     printf '%s:%s\n' "$1" "$2" ;;
  esac
}
show_version() {
  local v c go tools pr
  v=$(kv "$DIR/kit-version" version); c=$(kv "$DIR/kit-version" commit)
  go=$(kv "$DIR/versions" amneziawg-go); tools=$(kv "$DIR/versions" amneziawg-tools)
  echo "awg-vps-kit: ${v:-unknown} (${c:-unknown})"
  go=${go:-unknown}; tools=${tools:-unknown}
  pr=$(kv "$DIR/protocol" protocol); echo "protocol: ${pr:-1.0}"
  echo "amneziawg-go: ${go:0:7}"
  echo "amneziawg-tools: ${tools:0:7}"
}

cmd=${1:-help}
name=${2:-}

case "$cmd" in help|-h|--help) usage; exit 0 ;; esac
case "$cmd" in version|-v|--version) show_version; exit 0 ;; esac

[ "$(id -u)" = 0 ] || { echo "run as root" >&2; exit 1; }
umask 077

require_conf() { [ -f "$CONF" ] || { echo "no $CONF" >&2; exit 1; }; }
ensure_dirs() { mkdir -p "$CL" "$TXN_ROOT"; chmod 700 "$TXN_ROOT"; }

valid() { [[ "$1" =~ ^[A-Za-z0-9_-]{1,32}$ ]] || { echo "name: letters, digits, _ and - only (max 32); see: awg-client help" >&2; exit 1; }; }
client_mtu() {  # MTU for client configs: $DIR/client-mtu, else 1420 (also on 3.1: 1280 is a VPN fingerprint)
  local m; m=$(cat "$DIR/client-mtu" 2>/dev/null || true)
  if [ -n "$m" ]; then echo "$m"; return 0; fi
  echo 1420
}
client_dns() {  # DNS servers for client configs: $DIR/client-dns, default 1.1.1.1
  local d; d=$(cat "$DIR/client-dns" 2>/dev/null || true); echo "${d:-1.1.1.1}"
}
normalize_dns() {  # normalize_dns <a,b,c>: "a, b, c" for 1-3 IPv4 addresses, else nothing and return 1
  local -a addrs
  local list=$1 a o n=0 out=
  [[ "$list" =~ ^[0-9.,]+$ ]] || return 1
  case "$list" in ,*|*,|*,,*) return 1 ;; esac   # read -a would silently drop an empty last field
  IFS=, read -r -a addrs <<<"$list"
  for a in "${addrs[@]}"; do
    [[ "$a" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
    for o in "${BASH_REMATCH[@]:1}"; do
      [ "$o" = 0 ] || [[ "$o" != 0* ]] || return 1   # canonical octets: no leading zeros
      [ "$((10#$o))" -le 255 ] || return 1
    done
    out+="${out:+, }$a"; n=$((n+1))
  done
  { [ "$n" -ge 1 ] && [ "$n" -le 3 ]; } || return 1
  printf '%s\n' "$out"
}
iface_val() { awk -v k="$1" '/^\[Peer\]/{exit} $1==k && $2=="="{print $3; exit}' "$CONF"; }
engine_is_31() {  # exit 0 only when the installed engine is the reviewed 3.1 build
  local have want
  have=$(kv "$DIR/versions" amneziawg-go)
  want=$(kv "$DIR/upstream.lock" amneziawg-go)
  [[ "$have" =~ ^[0-9a-f]{40}$ ]] || return 1
  [ "$have" = "$want" ]
}
qr() { if command -v qrencode >/dev/null; then echo; qrencode -t ansiutf8 < "$1"; fi; }
# config between separator lines (only on screen, not in the file), then the QR code
SEP=############################################################
print_conf() { echo "$SEP"; cat "$CL/$1.conf"; echo "$SEP"; qr "$CL/$1.conf"; }
extra_fields() {  # protocol-specific lines: S3/S4, HeaderProtectionKey, RandomTrailers from the
  # server config; the 1.5/3.1 client fields (I1-I5, padding, timers) from the protocol file.
  local k v
  for k in S3 S4; do v=$(iface_val "$k"); [ -z "$v" ] || echo "$k = $v"; done
  for k in HeaderProtectionKey RandomTrailers; do v=$(iface_val "$k"); [ -z "$v" ] || echo "$k = $v"; done
  case "$(kv "$DIR/protocol" protocol)" in
    1.5) for k in I1 I2 I3 I4 I5; do v=$(kv "$DIR/protocol" "$k"); [ -z "$v" ] || echo "$k = $v"; done ;;
    3.1) for k in DisableCookies ContentPaddingAddition RekeyAfterTime RekeyTimeout RejectAfterTime KeepaliveTimeout MaxHandshakeAttempts I1 I2 I3 I4 I5; do v=$(kv "$DIR/protocol" "$k"); [ -z "$v" ] || echo "$k = $v"; done ;;
  esac
}
gen_conf() { gen_conf_raw "$@" | sed '/^H4 = /{n;/^$/d}'; }
gen_conf_raw() {  # name ip key psk
  local ip=$2 key=$3 psk=$4
  cat <<EOF
[Interface]
PrivateKey = $key
Address = $ip/32
DNS = $(client_dns)
MTU = $(client_mtu)
Jc = $(iface_val Jc)
Jmin = $(iface_val Jmin)
Jmax = $(iface_val Jmax)
S1 = $(iface_val S1)
S2 = $(iface_val S2)
H1 = $(iface_val H1)
H2 = $(iface_val H2)
H3 = $(iface_val H3)
H4 = $(iface_val H4)
$(extra_fields)

[Peer]
PublicKey = $(cat "$DIR/srv.pub")
PresharedKey = $psk
Endpoint = $(format_endpoint "$(cat "$DIR/endpoint")" "$(iface_val ListenPort)")
AllowedIPs = 0.0.0.0/0
PersistentKeepalive = 25
EOF
}
# Server fields of a protocol version, same generators as install.sh. 3.1 (target or current)
# also emits S1/S2: target 3.1 makes all four S equal (fresh awg_s31_value), downgrading from
# 3.1 keeps the current equal S1/S2. The 3.1 HeaderProtectionKey is a secret generated here.
protocol_fields() {  # protocol_fields <target> [<cur>]
  local target=$1 cur=${2:-} i=1 h s hpk
  if [ "$target" = 3.1 ]; then
    s=$(awg_s31_value)
    printf 'S1 = %s\nS2 = %s\nS3 = %s\nS4 = %s\n' "$s" "$s" "$s" "$s"
  else
    if [ "$cur" = 3.1 ]; then
      s=$(iface_val S1)
      printf 'S1 = %s\nS2 = %s\n' "$s" "$s"
    fi
    [ "$target" != 2.0 ] || awg_s34_values
  fi
  if [ "$target" = 3.1 ]; then
    hpk=$(awg genkey)
    [ -n "$hpk" ] || return 1
    echo "HeaderProtectionKey = $hpk"
    echo "RandomTrailers = on"
    echo "ContentPaddingAddition = 10-100"
  fi
  while IFS= read -r h; do echo "H$i = $h"; i=$((i+1)); done < <(awg_h_values "$target")
}
peer_ip() {  # tunnel address of the peer commented "# <name>"
  awk -v n="# $1" '/^\[Peer\]/{p=1;m=0;next} p&&$0==n{m=1} p&&m&&/^AllowedIPs/{sub(/\/32.*/,"",$3);print $3;exit}' "$CONF"
}

# ------------------------------------------------------------- peer transactions
# A mutation either completes or is rolled back. The runtime change happens before the
# files are published, so a failure never leaves a saved peer that is not running.
TXN=; PHASE=0; KIND=; TNAME=; TNEW=; TPUB=; TIP=; TPSK=; PTXN=

require_runtime() {
  awg show "$IF" >/dev/null 2>&1 || die "tunnel $IF is not running; start it before changing clients"
}
pending_txn() {
  local p
  p=$(find "$TXN_ROOT" -mindepth 1 -maxdepth 1 -type d \( -name 'peer.*' -o -name 'protocol.*' -o -name 'update.*' \) -print -quit 2>/dev/null || true)
  [ -z "$p" ] || die "unfinished operation at $p; check $CONF, then remove that directory"
}
begin_txn() {  # begin_txn <add|remove> <name> <pub> <ip> [psk-path]
  KIND=$1; TNAME=$2; TPUB=$3; TIP=$4; TPSK=${5:-}
  TXN=$(mktemp -d "$TXN_ROOT/peer.XXXXXX")
  chmod 700 "$TXN"
  cp -p "$CONF" "$TXN/old.conf"
  PHASE=0
}
end_txn() { [ -z "$TXN" ] || rm -rf "$TXN"; TXN=; PHASE=0; }
abort_peer_txn() {  # undo whatever phase we reached; return 1 if a step could not be undone
  [ -n "$TXN" ] || return 0
  local ok=0 f b
  if [ "$PHASE" -ge 1 ]; then
    case "$KIND" in
      add)    awg set "$IF" peer "$TPUB" remove >/dev/null 2>&1 || ok=1 ;;
      remove) awg set "$IF" peer "$TPUB" preshared-key "$TPSK" allowed-ips "$TIP/32" >/dev/null 2>&1 || ok=1 ;;
    esac
  fi
  if [ "$PHASE" -ge 2 ]; then
    cp -p "$TXN/old.conf" "$CONF" 2>/dev/null || ok=1
    case "$KIND" in
      add)
        rm -f "$CL/$TNAME".key "$CL/$TNAME".pub "$CL/$TNAME".psk "$CL/$TNAME".conf 2>/dev/null || ok=1 ;;
      rename)  # whatever was already moved goes back to the old name
        for f in key pub psk conf; do
          [ ! -e "$CL/$TNEW.$f" ] || mv -f "$CL/$TNEW.$f" "$CL/$TNAME.$f" 2>/dev/null || ok=1
        done ;;
      *)
        for f in "$TXN"/*; do
          b=$(basename "$f")
          case "$b" in old.conf|new.conf) continue ;; esac
          cp -p "$f" "$CL/$b" 2>/dev/null || ok=1
        done ;;
    esac
  fi
  if [ "$ok" = 0 ]; then rm -rf "$TXN"; TXN=; PHASE=0; return 0; fi
  return 1
}
fail_txn() {  # fail_txn <message>: roll back, or keep the directory for manual recovery
  local msg=$1 dir=$TXN
  if abort_peer_txn; then die "$msg (changes rolled back)"; fi
  echo "error: $msg; automatic rollback FAILED" >&2
  echo "recovery: inspect $CONF and $dir manually, then remove $dir" >&2
  exit 1
}
on_signal() {
  if [ -n "$PTXN" ]; then
    # Protocol files are restored even if the restart was in flight: a consistent old
    # profile is recoverable, a half-written one is not.
    [ ! -f "$PTXN/old.conf" ] || cp -p "$PTXN/old.conf" "$CONF"
    [ ! -f "$PTXN/old.protocol" ] || cp -p "$PTXN/old.protocol" "$DIR/protocol"
    rm -rf "$PTXN"; PTXN=
    echo "interrupted: previous protocol files restored; restart the tunnel to apply" >&2
    exit 130
  fi
  if [ -n "$TXN" ] && ! abort_peer_txn; then
    echo "warning: interrupted and rollback failed; recovery data kept in $TXN" >&2
  fi
  exit 130
}
trap on_signal INT TERM

drop_peer() {  # drop_peer <name> < conf: print conf without the [Peer] block commented "# <name>"
  # Line based: a block starts at any "[Section]" line, so peers that are not separated
  # by blank lines (hand-edited files) are still told apart. Trailing blank lines are trimmed.
  awk -v n="# $1" '
    function flush() { if (!(peer && hit)) out = out buf; buf = ""; peer = 0; hit = 0 }
    /^\[/ { flush(); peer = ($0 ~ /^\[Peer\]/) }
    { buf = buf $0 "\n"; if (peer && $0 == n) hit = 1 }
    END { flush(); sub(/\n+$/, "\n", out); printf "%s", out }'
}
rename_peer() {  # rename_peer <old> <new> < conf: the "# <old>" comment of a [Peer] block becomes "# <new>"; fails unless exactly one
  awk -v o="# $1" -v n="# $2" '
    /^\[/ { peer = ($0 ~ /^\[Peer\]/) }
    peer && $0 == o { print n; c++; next }
    { print }
    END { exit (c == 1 ? 0 : 1) }'
}
# list -v: one row per client with the live state of the tunnel (last handshake, traffic, endpoint)
list_verbose() {
  local dump
  dump=$(awg show "$IF" dump 2>/dev/null || true)
  [ -n "$dump" ] || echo "note: tunnel $IF is not running, no live data" >&2
  # table 1: address, name and public key of every [Peer] block; table 2: `awg show dump`
  # (first line is the interface, then one line per peer: key, psk, endpoint, allowed ips,
  # latest handshake as epoch seconds, received bytes, sent bytes, keepalive)
  awk -F'\t' -v now="$(date +%s)" '
    function human(b,   u, i) {
      split("B KiB MiB GiB TiB", u, " "); i = 1
      while (b >= 1024 && i < 5) { b /= 1024; i++ }
      return (i == 1) ? sprintf("%d B", b) : sprintf("%.1f %s", b, u[i])
    }
    function ago(t,   d) {
      if (t == 0) return "never"
      d = now - t; if (d < 0) d = 0
      if (d < 5) return "just now"
      if (d < 60) return d "s ago"
      if (d < 3600) return int(d / 60) "m ago"
      if (d < 86400) return int(d / 3600) "h ago"
      return int(d / 86400) "d ago"
    }
    function pad(s, w) { return sprintf("%-" w "s", s) }
    function lpad(s, w) { return sprintf("%" w "s", s) }
    FILENAME == ARGV[1] { n++; ip[n] = $1; nm[n] = $2; idx[$3] = n; next }
    FNR > 1 && ($1 in idx) { i = idx[$1]; hs[i] = $5; ep[i] = $3; rx[i] = $6; tx[i] = $7; live[i] = 1 }
    END {
      if (n == 0) { print "no clients"; exit }
      wn = 4; wa = 7; wh = 9; wr = 2; wt = 2
      for (i = 1; i <= n; i++) {
        c1[i] = nm[i]; c2[i] = ip[i]
        c3[i] = live[i] ? ago(hs[i]) : "-"
        c4[i] = live[i] ? human(rx[i]) : "-"; c5[i] = live[i] ? human(tx[i]) : "-"
        c6[i] = (live[i] && ep[i] != "(none)") ? ep[i] : "-"
        if (length(c1[i]) > wn) wn = length(c1[i]); if (length(c2[i]) > wa) wa = length(c2[i])
        if (length(c3[i]) > wh) wh = length(c3[i]); if (length(c4[i]) > wr) wr = length(c4[i])
        if (length(c5[i]) > wt) wt = length(c5[i])
      }
      print pad("NAME", wn) "  " pad("ADDRESS", wa) "  " pad("HANDSHAKE", wh) "  " lpad("RX", wr) "  " lpad("TX", wt) "  ENDPOINT"
      for (i = 1; i <= n; i++)
        print pad(c1[i], wn) "  " pad(c2[i], wa) "  " pad(c3[i], wh) "  " lpad(c4[i], wr) "  " lpad(c5[i], wt) "  " c6[i]
    }' \
    <(awk '
        function out() { if (p && ip != "") print ip "\t" n "\t" k }
        /^\[/ { out(); p = ($0 ~ /^\[Peer\]/); n = ""; k = ""; ip = ""; next }
        p && /^# / { n = substr($0, 3) }
        p && $1 == "PublicKey" { k = $3 }
        p && $1 == "AllowedIPs" { ip = $3; sub(/\/32.*/, "", ip) }
        END { out() }' "$CONF" | sort -V) \
    <(printf '%s\n' "$dump")
}
list_names() { awk '/^\[Peer\]/{p=1;n="";next} p&&/^# /{n=substr($0,3)} p&&/^AllowedIPs/{print n; p=0}' "$CONF"; }
make_protocol_file() {  # make_protocol_file <version> <source> <dest>: keep every other key
  local ver=$1 src=$2 dst=$3 seen=0 line key
  : > "$dst"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      protocol=*) seen=1; printf 'protocol=%s\n' "$ver" >> "$dst" ;;
      '') ;;
      *) printf '%s\n' "$line" >> "$dst" ;;
    esac
  done < "$src"
  [ "$seen" = 1 ] || printf 'protocol=%s\n' "$ver" >> "$dst"
  if [ "$ver" = 1.5 ] && ! grep -q '^I1=' "$dst"; then
    echo "I1=$AWG_I1_DEFAULT" >> "$dst"
  fi
  if [ "$ver" = 3.1 ]; then
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      key=${line%%=*}
      [ -n "$(kv "$dst" "$key")" ] || printf '%s\n' "$line" >> "$dst"
    done < <(awg_31_client_defaults)
  fi
}

case "$cmd" in
  list)
    case "$name" in
      '') verbose=0 ;;
      -v|--verbose) verbose=1 ;;
      *) echo "unknown option for list: $name (usage: awg-client list [-v])" >&2; exit 1 ;;
    esac
    require_conf
    if [ "$verbose" = 1 ]; then list_verbose; exit 0; fi
    awk '/^\[Peer\]/{p=1;n="";next} p&&/^# /{n=substr($0,3)} p&&/^AllowedIPs/{print $3"\t"n; p=0}' "$CONF" | sort -V
    exit 0 ;;
  dns)
    [ -n "$name" ] || { client_dns; exit 0; }
    if [ "$name" != default ]; then
      dns=$(normalize_dns "$name") || {
        echo "dns must be 1-3 IPv4 addresses separated by commas, e.g. 1.1.1.1,8.8.8.8 (or: default)" >&2; exit 1; }
    fi
    take_lock
    require_conf
    ensure_dirs
    if [ "$name" = default ]; then
      rm -f "$DIR/client-dns"
      echo "client DNS = $(client_dns) (default; new and re-shown configs, devices must re-import: awg-client show <name>)"
      exit 0
    fi
    printf '%s\n' "$dns" > "$DIR/client-dns.new" && mv -f "$DIR/client-dns.new" "$DIR/client-dns"
    chmod 644 "$DIR/client-dns"
    echo "client DNS = $dns (new and re-shown configs; devices must re-import: awg-client show <name>)"
    exit 0 ;;
  rename)
    old=$name; new=${3:-}
    valid "$old"; valid "$new"
    [ "$old" != "$new" ] || { echo "old and new name are the same" >&2; exit 1; }
    take_lock
    require_conf
    ensure_dirs
    pending_txn
    ip=$(peer_ip "$old")
    if [ -z "$ip" ] || [ ! -f "$CL/$old.key" ]; then echo "no such client: $old (see: awg-client list)" >&2; exit 1; fi
    if [ -n "$(peer_ip "$new")" ] || [ -e "$CL/$new.conf" ] || [ -e "$CL/$new.key" ] \
       || awk -v n="# $new" '$0==n{f=1} END{exit !f}' "$CONF"; then
      echo "name $new is already used (see: awg-client list)" >&2; exit 1
    fi
    begin_txn rename "$old" "" "$ip"
    TNEW=$new
    # prepare the whole result first, and check that exactly one comment changed
    rename_peer "$old" "$new" < "$CONF" > "$TXN/new.conf" || fail_txn "cannot prepare the new $CONF (is there exactly one [Peer] block for $old?)"
    [ "$(grep -c '' "$TXN/new.conf")" = "$(grep -c '' "$CONF")" ] || fail_txn "the renamed $CONF changed in length; refusing to write it"
    mv -f "$TXN/new.conf" "$CONF" || fail_txn "cannot write $CONF"
    PHASE=2
    for ext in key pub psk conf; do
      [ ! -e "$CL/$old.$ext" ] || mv -f "$CL/$old.$ext" "$CL/$new.$ext" || fail_txn "cannot rename $CL/$old.$ext"
    done
    end_txn
    echo "renamed $old -> $new (address $ip, keys and the running peer are unchanged: the device keeps working)"
    exit 0 ;;
  export)
    dest=${name:-./awg-clients-$(hostname -s 2>/dev/null || echo server)-$(date +%Y%m%d-%H%M%S).tar.gz}
    [ ! -e "$dest" ] || { echo "$dest already exists; choose another file" >&2; exit 1; }
    take_lock
    require_conf
    ensure_dirs
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    count=0
    while IFS=$'\t' read -r ip n; do
      if [ ! -f "$CL/$n.key" ] || [ ! -f "$CL/$n.psk" ]; then echo "warning: skipping $n: its key files are missing" >&2; continue; fi
      gen_conf "$n" "$ip" "$(cat "$CL/$n.key")" "$(cat "$CL/$n.psk")" > "$tmp/$n.conf" || die "cannot generate the config of $n"
      count=$((count+1))
    done < <(awk '/^\[Peer\]/{p=1;n="";next} p&&/^# /{n=substr($0,3)} p&&/^AllowedIPs/{sub(/\/32.*/,"",$3); print $3"\t"n; p=0}' "$CONF" | sort -V)
    [ "$count" -gt 0 ] || die "no clients to export"
    if ! ( cd "$tmp" && printf '%s\n' ./*.conf ) | tar -czf "$dest" -C "$tmp" -T -; then
      rm -f "$dest"; die "cannot write $dest"
    fi
    echo "exported $count client config(s) to $dest"
    echo "the archive contains private keys: keep it safe and delete it when it is no longer needed"
    exit 0 ;;
  show)
    valid "$name"
    take_lock
    require_conf
    ensure_dirs
    if [ -n "$(find "$TXN_ROOT" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | head -1)" ]; then
      echo "warning: an unfinished operation is present in $TXN_ROOT; check it before changing clients" >&2
    fi
    ip=$(peer_ip "$name")
    if [ -z "$ip" ] || [ ! -f "$CL/$name.key" ]; then echo "no such client: $name (see: awg-client list)" >&2; exit 1; fi
    tmp=$CL/.$name.conf.$$
    trap 'rm -f "$tmp"' EXIT
    gen_conf "$name" "$ip" "$(cat "$CL/$name.key")" "$(cat "$CL/$name.psk")" > "$tmp"
    mv -f "$tmp" "$CL/$name.conf"
    print_conf "$name"
    exit 0 ;;
  protocol)
    cur=$(kv "$DIR/protocol" protocol); cur=${cur:-1.0}
    [ -n "$name" ] || { echo "$cur"; exit 0; }
    case "$name" in 1.0|1.5|2.0|3.1) ;; *) echo "protocol must be 1.0, 1.5, 2.0 or 3.1" >&2; exit 1 ;; esac
    take_lock
    require_conf
    ensure_dirs
    pending_txn
    cur=$(kv "$DIR/protocol" protocol); cur=${cur:-1.0}   # re-read under the lock
    [ "$name" != "$cur" ] || { echo "protocol is already $cur"; exit 0; }
    if [ "$name" = 3.1 ]; then
      # 3.1 needs the reviewed engine; refuse before touching any file (see update.sh).
      engine_is_31 || die "installed amneziawg-go is not the reviewed 3.1 build; run update.sh first"
    fi

    pt=$(mktemp -d "$TXN_ROOT/protocol.XXXXXX"); chmod 700 "$pt"
    PTXN=$pt
    cp -p "$CONF" "$pt/old.conf"
    cp -p "$DIR/protocol" "$pt/old.protocol"
    stamp=$(date +%Y%m%d-%H%M%S)

    # 1.0 <-> 1.5 changes client-side metadata only: the server fields are identical,
    # so rewriting awg0.conf or restarting the tunnel would disconnect every client
    # for nothing. Custom I1..I5 are kept; they are exported only while the protocol is 1.5.
    case "$cur:$name" in
      1.0:1.5|1.5:1.0)
        if make_protocol_file "$name" "$pt/old.protocol" "$pt/protocol" \
           && mv -f "$pt/protocol" "$DIR/protocol"; then
          rm -rf "$pt"; PTXN=
          echo "protocol $cur -> $name (server fields unchanged, no restart)"
          echo "Clients get the I1..I5 fields for 1.5: awg-client show <name>"
          exit 0
        fi
        rm -rf "$pt"; PTXN=
        die "cannot write $DIR/protocol" ;;
    esac

    backup="$CONF.bak-protocol-$cur.$stamp"
    if [ "$name" = 3.1 ] || [ "$cur" = 3.1 ]; then
      strip='^(S[1-4]|H[1-4]|HeaderProtectionKey|RandomTrailers|ContentPaddingAddition) ='
      anchor='^Jmax ='
    else
      strip='^(S3|S4|H[1-4]) ='
      anchor='^S2 ='
    fi
    protocol_fields "$name" "$cur" > "$pt/fields" || { rm -rf "$pt"; PTXN=; die "awg genkey failed; cannot generate the HeaderProtectionKey for protocol 3.1"; }
    # the new fields replace the obfuscation fields in [Interface]: after Jmax for 3.1 (which
    # also rewrites S1/S2 and the 3.x keys), after S2 otherwise (unchanged from before)
    awk -v f="$pt/fields" -v strip="$strip" -v anchor="$anchor" \
      '/^\[Peer\]/{p=1} !p && $0 ~ strip {next} {print} !p && $0 ~ anchor {n++; while ((getline l < f) > 0) print l} \
       END { exit (n == 1 ? 0 : 1) }' \
      "$CONF" > "$pt/new.conf" || { rm -rf "$pt"; PTXN=; die "cannot rewrite $CONF: expected exactly one \"$anchor\" line (hand-edited config?)"; }
    make_protocol_file "$name" "$pt/old.protocol" "$pt/protocol"
    if ! mv -f "$pt/new.conf" "$CONF"; then rm -rf "$pt"; PTXN=; die "cannot write $CONF"; fi
    if ! mv -f "$pt/protocol" "$DIR/protocol"; then
      cp -p "$pt/old.conf" "$CONF"; rm -rf "$pt"; PTXN=; die "cannot write $DIR/protocol; $CONF restored"
    fi
    cp -p "$pt/old.conf" "$backup"
    cp -p "$pt/old.protocol" "$DIR/protocol.bak-$cur.$stamp"
    # every backup holds the server private key: do not let them pile up
    prune_backups "$CONF.bak-protocol-"
    prune_backups "$DIR/protocol.bak-"

    if systemctl is-active --quiet "awg-quick@$IF" 2>/dev/null; then
      if systemctl restart "awg-quick@$IF"; then
        rm -rf "$pt"; PTXN=
        echo "protocol $cur -> $name (backup: $backup)"
        echo "tunnel restarted; all clients are offline until they get the new config"
      else
        cp -p "$pt/old.conf" "$CONF"
        cp -p "$pt/old.protocol" "$DIR/protocol"
        if systemctl restart "awg-quick@$IF"; then
          rm -rf "$pt"; PTXN=
          die "restart with $name failed; restored $cur and the tunnel is up again"
        fi
        rm -rf "$pt"; PTXN=
        echo "error: restart with $name failed and $cur did not start either" >&2
        echo "files are restored to $cur; recovery: systemctl restart awg-quick@$IF" >&2
        exit 1
      fi
    else
      rm -rf "$pt"; PTXN=
      echo "protocol $cur -> $name (backup: $backup)"
      echo "tunnel is not running as a service: restart it to apply"
    fi
    if [ "$name" = 3.1 ]; then
      echo "every client needs AWG 3.1 support (Amnezia VPN >= 5.0.1.5); container bridges like AmneziaWG-to-Proxy do not (see README)"
    fi
    echo "New configs: awg-client show <name> for:"
    list_names | sed 's/^/  /'
    exit 0 ;;
  mtu)
    [ -n "$name" ] || { client_mtu; exit 0; }
    if ! [[ "$name" =~ ^[0-9]+$ ]] || [ "$name" -lt 1280 ] || [ "$name" -gt 1500 ]; then
      echo "mtu must be a number from 1280 to 1500" >&2; exit 1
    fi
    take_lock
    require_conf
    ensure_dirs
    printf '%s\n' "$name" > "$DIR/client-mtu.new" && mv -f "$DIR/client-mtu.new" "$DIR/client-mtu"
    chmod 644 "$DIR/client-mtu"
    echo "client MTU = $name (new and re-shown configs; devices must re-import: awg-client show <name>)"
    exit 0 ;;
  endpoint)
    [ -n "$name" ] || { cat "$DIR/endpoint" 2>/dev/null || echo "(not set)"; exit 0; }
    valid_endpoint "$name" || { echo "endpoint must be an IPv4 address, an IPv6 address or a DNS name (no port, no brackets)" >&2; exit 1; }
    take_lock
    require_conf
    ensure_dirs
    if [ "$(cat "$DIR/endpoint" 2>/dev/null)" = "$name" ]; then echo "endpoint is already $name" >&2; exit 1; fi
    cp -p "$DIR/endpoint" "$DIR/endpoint.bak-$(date +%Y%m%d%H%M%S)" 2>/dev/null || true
    printf '%s
' "$name" > "$DIR/endpoint.new" && mv -f "$DIR/endpoint.new" "$DIR/endpoint"
    chmod 644 "$DIR/endpoint"
    n=0
    while IFS= read -r c; do
      if [ -z "$c" ] || [ ! -f "$CL/$c.key" ]; then continue; fi
      ip=$(peer_ip "$c")
      if [ -z "$ip" ]; then continue; fi
      tmp=$CL/.$c.conf.$$
      if gen_conf "$c" "$ip" "$(cat "$CL/$c.key")" "$(cat "$CL/$c.psk")" > "$tmp" && chmod 600 "$tmp" && mv -f "$tmp" "$CL/$c.conf"; then n=$((n+1)); fi
      rm -f "$tmp"
    done < <(list_names)
    echo "endpoint = $name ($n client files rewritten; the tunnel is untouched; devices must re-import: awg-client show <name>)"
    exit 0 ;;
  remove)
    valid "$name"
    take_lock
    require_conf
    ensure_dirs
    pending_txn
    pub=$(cat "$CL/$name.pub" 2>/dev/null || cat "$DIR/$name.pub" 2>/dev/null || true)
    [ -n "$pub" ] || { echo "no such client: $name (see: awg-client list)" >&2; exit 1; }
    require_runtime
    ip=$(peer_ip "$name")
    [ -n "$ip" ] || { echo "no address for $name in $CONF; refusing to guess" >&2; exit 1; }
    begin_txn remove "$name" "$pub" "$ip"
    # keep a copy of every client file so a failed commit can restore it
    for f in "$CL/$name".* "$DIR/$name".*; do
      [ ! -e "$f" ] || cp -p "$f" "$TXN/"
    done
    TPSK=$TXN/$name.psk
    # prepare the whole result before changing the runtime
    drop_peer "$name" < "$CONF" > "$TXN/new.conf" || fail_txn "cannot prepare the new $CONF"
    # exactly one block may go: anything else means the file is not in the expected shape
    [ "$(grep -c '^\[Peer\]' "$TXN/new.conf")" = "$(( $(grep -c '^\[Peer\]' "$CONF") - 1 ))" ] \
      || fail_txn "$CONF does not have exactly one [Peer] block for $name; refusing to edit it"
    PHASE=1
    awg set "$IF" peer "$pub" remove || { PHASE=0; fail_txn "cannot revoke $name on the running interface"; }
    mv -f "$TXN/new.conf" "$CONF" || fail_txn "cannot write $CONF; $name was revoked"
    PHASE=2
    rm -f "$CL/$name".* "$DIR/$name".{key,pub,psk,conf} || fail_txn "cannot delete files of $name"
    end_txn
    echo "removed $name"
    exit 0 ;;
  add) ;;
  *) echo "unknown command: $cmd" >&2; echo >&2; usage >&2; exit 1 ;;
esac

valid "$name"
take_lock
require_conf
ensure_dirs
pending_txn
[ ! -e "$CL/$name.conf" ] || { echo "client $name already exists (use: awg-client show $name)" >&2; exit 1; }
awk -v n="# $name" '$0==n{f=1} END{exit !f}' "$CONF" && { echo "name $name already used in $CONF" >&2; exit 1; }
require_runtime

addr=$(iface_val Address)            # e.g. 10.77.0.1/24
base=${addr%.*}.                     # 10.77.0.

used=$(grep -E '^AllowedIPs' "$CONF" | grep -o "${base//./\.}[0-9]*" | sed "s/^${base//./\.}//" | sort -n || true)
n=2
while [ $n -le 254 ]; do
  echo "$used" | grep -qx "$n" || break
  n=$((n+1))
done
[ $n -le 254 ] || { echo "no free addresses" >&2; exit 1; }
ip=$base$n

key=$(awg genkey); pub=$(printf %s "$key" | awg pubkey); psk=$(awg genpsk)
begin_txn add "$name" "$pub" "$ip"
printf %s "$key" > "$TXN/$name.key"
printf %s "$pub" > "$TXN/$name.pub"
printf %s "$psk" > "$TXN/$name.psk"
chmod 600 "$TXN/$name.key" "$TXN/$name.pub" "$TXN/$name.psk"
TPSK=$TXN/$name.psk

# Stage everything before the runtime change: a disk error must not leave a running
# peer with no saved config (or a revoked peer still listed in awg0.conf).
gen_conf "$name" "$ip" "$key" "$psk" > "$TXN/$name.conf" || fail_txn "cannot prepare the client config"
{
  cat "$TXN/old.conf"
  printf '\n[Peer]\n# %s\nPublicKey = %s\nPresharedKey = %s\nAllowedIPs = %s/32\n' "$name" "$pub" "$psk" "$ip"
} > "$TXN/new.conf" || fail_txn "cannot prepare the new $CONF"

PHASE=1
awg set "$IF" peer "$pub" preshared-key "$TXN/$name.psk" allowed-ips "$ip/32" \
  || { PHASE=0; fail_txn "cannot add $name to the running interface"; }

mv -f "$TXN/new.conf" "$CONF" || fail_txn "cannot write $CONF"
PHASE=2
for f in key pub psk conf; do
  mv -f "$TXN/$name.$f" "$CL/$name.$f" || fail_txn "cannot publish $CL/$name.$f"
done
end_txn

echo "# client $name -> $ip (saved: $CL/$name.conf)"
print_conf "$name"
