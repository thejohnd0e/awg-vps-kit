#!/bin/bash
# awg-client: manage AmneziaWG clients on this server.
set -euo pipefail
DIR=/etc/amnezia/amneziawg
IF=awg0
CONF=$DIR/$IF.conf
CL=$DIR/clients

usage() {
cat <<'EOF'
awg-client - manage AmneziaWG clients on this server (run as root)

Usage:
  awg-client add <name>      create a client, print its config and QR code
  awg-client show <name>     print an existing client's config and QR code again
  awg-client list            list all clients with their tunnel addresses
  awg-client remove <name>   remove a client (takes effect immediately)
  awg-client version         show installed kit and amneziawg versions
  awg-client protocol [1.0|1.5|2.0]   show or change the protocol version of this server
  awg-client mtu [1280-1500]          show or set the MTU written into client configs (default 1420)
  awg-client help            this help

Notes:
  - Name: letters, digits, _ and - only (max 32 characters).
  - The next free tunnel address is picked automatically.
  - Clients are added to the running tunnel without a restart and are
    also written to /etc/amnezia/amneziawg/awg0.conf (survives reboot).
  - Client files: /etc/amnezia/amneziawg/clients/<name>.{conf,key,pub,psk}
  - One config per device: two devices on the same config kick each other off.
  - Removing a client disconnects that device immediately.
  - `protocol 2.0` rewrites the server obfuscation fields and restarts the tunnel: every client
    must then get its new config (`awg-client show <name>`), old configs stop working.
  - `mtu N` only changes the MTU line of client configs (server awg0 is not touched, no restart).
    Devices that are already set up keep their old MTU until they import `awg-client show <name>` again.
  - Details: /etc/amnezia/amneziawg/README.md
EOF
}

kv() {  # kv <file> <key>: value from a key=value file, empty if missing
  awk -F= -v k="$2" '$1==k{print $2; exit}' "$1" 2>/dev/null || true
}
show_version() {
  local v c go tools pr
  v=$(kv "$DIR/kit-version" version); c=$(kv "$DIR/kit-version" commit)
  go=$(kv "$DIR/versions" amneziawg-go); tools=$(kv "$DIR/versions" amneziawg-tools)
  echo "awg-vps-kit: ${v:-unknown} (${c:-unknown})"
  go=${go:-unknown}; tools=${tools:-unknown}
  pr=$(kv "$DIR/protocol" protocol); echo "protocol: ${pr:-1.0}"
  echo "amneziawg-go: ${go:0:7}"
  echo "amneziawg-tools: ${tools:0:7}"
}

cmd=${1:-help}
name=${2:-}

case "$cmd" in help|-h|--help) usage; exit 0 ;; esac
case "$cmd" in version|-v|--version) show_version; exit 0 ;; esac

[ "$(id -u)" = 0 ] || { echo "run as root" >&2; exit 1; }
[ -f "$CONF" ] || { echo "no $CONF" >&2; exit 1; }
umask 077
mkdir -p "$CL"

valid() { [[ "$1" =~ ^[A-Za-z0-9_-]{1,32}$ ]] || { echo "name: letters, digits, _ and - only (max 32); see: awg-client help" >&2; exit 1; }; }
client_mtu() {  # MTU for client configs: $DIR/client-mtu, default 1420 (1500 minus 80 bytes of tunnel overhead)
  local m; m=$(cat "$DIR/client-mtu" 2>/dev/null || true); echo "${m:-1420}"
}
iface_val() { awk -v k="$1" '/^\[Peer\]/{exit} $1==k && $2=="="{print $3; exit}' "$CONF"; }
qr() { if command -v qrencode >/dev/null; then echo; qrencode -t ansiutf8 < "$1"; fi; }
# config between separator lines (only on screen, not in the file), then the QR code
SEP=############################################################
print_conf() { echo "$SEP"; cat "$CL/$1.conf"; echo "$SEP"; qr "$CL/$1.conf"; }
extra_fields() {  # protocol-specific lines (S3/S4 from the server config, I1 from the protocol file)
  local k v
  for k in S3 S4; do v=$(iface_val "$k"); [ -z "$v" ] || echo "$k = $v"; done
  for k in I1 I2 I3 I4 I5; do v=$(kv "$DIR/protocol" "$k"); [ -z "$v" ] || echo "$k = $v"; done
}
gen_conf() { gen_conf_raw "$@" | sed '/^H4 = /{n;/^$/d}'; }
gen_conf_raw() {  # name ip key psk
  local ip=$2 key=$3 psk=$4
  cat <<EOF
[Interface]
PrivateKey = $key
Address = $ip/32
DNS = 1.1.1.1
MTU = $(client_mtu)
Jc = $(iface_val Jc)
Jmin = $(iface_val Jmin)
Jmax = $(iface_val Jmax)
S1 = $(iface_val S1)
S2 = $(iface_val S2)
H1 = $(iface_val H1)
H2 = $(iface_val H2)
H3 = $(iface_val H3)
H4 = $(iface_val H4)
$(extra_fields)

[Peer]
PublicKey = $(cat "$DIR/srv.pub")
PresharedKey = $psk
Endpoint = $(cat "$DIR/endpoint"):$(iface_val ListenPort)
AllowedIPs = 0.0.0.0/0
PersistentKeepalive = 25
EOF
}
rnd32() { local v=0; while [ "$v" -lt 5 ]; do v=$(od -An -N4 -tu4 /dev/urandom | tr -d " "); done; echo "$v"; }
# Server fields of a protocol version, S3/S4/H1-H4 lines (same rules as install.sh).
protocol_fields() {
  local v i; local -a H R
  if [ "$1" = 2.0 ]; then
    echo "S3 = $(shuf -i 8-64 -n 1)"; echo "S4 = $(shuf -i 4-32 -n 1)"
    R=(); while [ ${#R[@]} -lt 8 ]; do v=$(rnd32); case " ${R[*]} " in *" $v "*) ;; *) R+=("$v") ;; esac; done
    mapfile -t R < <(printf '%s
' "${R[@]}" | sort -n)
    H=("${R[0]}-${R[1]}" "${R[2]}-${R[3]}" "${R[4]}-${R[5]}" "${R[6]}-${R[7]}")
  else
    H=(); while [ ${#H[@]} -lt 4 ]; do v=$(rnd32); case " ${H[*]} " in *" $v "*) ;; *) H+=("$v") ;; esac; done
  fi
  for i in 0 1 2 3; do echo "H$((i+1)) = ${H[$i]}"; done
}
peer_ip() {  # tunnel address of the peer commented "# <name>"
  awk -v n="# $1" '/^\[Peer\]/{p=1;m=0;next} p&&$0==n{m=1} p&&m&&/^AllowedIPs/{sub(/\/32.*/,"",$3);print $3;exit}' "$CONF"
}

case "$cmd" in
  list)
    awk '/^\[Peer\]/{p=1;n="";next} p&&/^# /{n=substr($0,3)} p&&/^AllowedIPs/{print $3"\t"n; p=0}' "$CONF" | sort -V
    exit 0 ;;
  show)
    valid "$name"
    ip=$(peer_ip "$name")
    if [ -z "$ip" ] || [ ! -f "$CL/$name.key" ]; then echo "no such client: $name (see: awg-client list)" >&2; exit 1; fi
    gen_conf "$name" "$ip" "$(cat "$CL/$name.key")" "$(cat "$CL/$name.psk")" > "$CL/$name.conf"
    print_conf "$name"
    exit 0 ;;
  protocol)
    cur=$(kv "$DIR/protocol" protocol); cur=${cur:-1.0}
    [ -n "$name" ] || { echo "$cur"; exit 0; }
    case "$name" in 1.0|1.5|2.0) ;; *) echo "protocol must be 1.0, 1.5 or 2.0" >&2; exit 1 ;; esac
    [ "$name" != "$cur" ] || { echo "protocol is already $cur"; exit 0; }
    cp "$CONF" "$CONF.bak-protocol-$cur"
    protocol_fields "$name" > "$CONF.fields"
    # the new fields replace S3/S4/H1-H4 in the [Interface] section, right after S2
    awk -v f="$CONF.fields" '/^\[Peer\]/{p=1} !p&&/^(S3|S4|H[1-4]) =/{next} {print} !p&&/^S2 =/{while((getline l<f)>0)print l}' "$CONF" > "$CONF.tmp"
    mv "$CONF.tmp" "$CONF"; rm -f "$CONF.fields"
    {
      echo "protocol=$name"
      [ "$name" != 1.5 ] || echo "I1=<b 0xc00000000108><r 8><b 0x00><r 64>"
    } > "$DIR/protocol"
    echo "protocol $cur -> $name (backup: $CONF.bak-protocol-$cur)"
    if systemctl is-active --quiet "awg-quick@$IF" 2>/dev/null; then
      systemctl restart "awg-quick@$IF"; echo "tunnel restarted; all clients are offline until they get the new config"
    else
      echo "tunnel is not running as a service: restart it to apply"
    fi
    echo "New configs: awg-client show <name> for:"; "$0" list | cut -f2 | sed 's/^/  /'
    exit 0 ;;
  mtu)
    [ -n "$name" ] || { client_mtu; exit 0; }
    if ! [[ "$name" =~ ^[0-9]+$ ]] || [ "$name" -lt 1280 ] || [ "$name" -gt 1500 ]; then
      echo "mtu must be a number from 1280 to 1500" >&2; exit 1
    fi
    echo "$name" > "$DIR/client-mtu"
    echo "client MTU = $name (new and re-shown configs; devices must re-import: awg-client show <name>)"
    exit 0 ;;
  remove)
    valid "$name"
    pub=$(cat "$CL/$name.pub" 2>/dev/null || cat "$DIR/$name.pub" 2>/dev/null || true)
    [ -n "$pub" ] || { echo "no such client: $name (see: awg-client list)" >&2; exit 1; }
    cp "$CONF" "$CONF.bak-awg-client"
    awg set $IF peer "$pub" remove || true
    awk -v n="# $name" 'BEGIN{RS="";ORS="\n\n"} !($0 ~ /^\[Peer\]/ && index($0, "\n" n "\n"))' "$CONF" > "$CONF.tmp"
    mv "$CONF.tmp" "$CONF"
    rm -f "$CL/$name".* "$DIR/$name".{key,pub,psk,conf}
    echo "removed $name"
    exit 0 ;;
  add) ;;
  *) echo "unknown command: $cmd" >&2; echo >&2; usage >&2; exit 1 ;;
esac

valid "$name"
[ ! -e "$CL/$name.conf" ] || { echo "client $name already exists (use: awg-client show $name)" >&2; exit 1; }
awk -v n="# $name" '$0==n{f=1} END{exit !f}' "$CONF" && { echo "name $name already used in $CONF" >&2; exit 1; }

addr=$(iface_val Address)            # e.g. 10.77.0.1/24
base=${addr%.*}.                     # 10.77.0.

used=$(grep -E '^AllowedIPs' "$CONF" | grep -o "${base//./\.}[0-9]*" | sed "s/^${base//./\.}//" | sort -n || true)
n=2
while [ $n -le 254 ]; do
  echo "$used" | grep -qx "$n" || break
  n=$((n+1))
done
[ $n -le 254 ] || { echo "no free addresses" >&2; exit 1; }
ip=$base$n

key=$(awg genkey); pub=$(printf %s "$key" | awg pubkey); psk=$(awg genpsk)
printf %s "$key" > "$CL/$name.key"; printf %s "$pub" > "$CL/$name.pub"; printf %s "$psk" > "$CL/$name.psk"

cp "$CONF" "$CONF.bak-awg-client"
printf '\n[Peer]\n# %s\nPublicKey = %s\nPresharedKey = %s\nAllowedIPs = %s/32\n' "$name" "$pub" "$psk" "$ip" >> "$CONF"
awg set $IF peer "$pub" preshared-key "$CL/$name.psk" allowed-ips "$ip/32"

gen_conf "$name" "$ip" "$key" "$psk" > "$CL/$name.conf"

echo "# client $name -> $ip (saved: $CL/$name.conf)"
print_conf "$name"
